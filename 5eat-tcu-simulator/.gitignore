# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Build / packaging artifacts
build/
dist/
*.spec.bak

# Bundled driver binaries — fetched at build time via fetch_drivers.ps1, not tracked
drivers/**/*.exe
drivers/**/*.zip

# Firmware: the supplied TCU ROM set in roms/ IS tracked; ignore stray firmware elsewhere
*.bin
*.hex
!roms/
!roms/*.bin

# Runtime output
logs/
*.log
server.err

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
