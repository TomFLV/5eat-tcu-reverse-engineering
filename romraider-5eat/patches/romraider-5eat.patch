+
+/**
+ * Drag-and-drop editor for the 5EAT shift schedule.
+ *
+ * The Shift Map table is a grid of numbers, which is exact but is not how anyone
+ * thinks about shift points. The factory documents the schedule as a chart -
+ * vehicle speed across, accelerator angle up, one line per shift event - and that
+ * is the shape this draws, from the live table, with the vertices draggable.
+ *
+ * WHAT IS EDITABLE, AND WHY ONLY THAT
+ *
+ * Dragging is constrained to the horizontal. Each vertex is (speed, pedal): the
+ * speed is a cell of this table and can be changed, but the pedal position is the
+ * table's axis, which lives in a different field of the ROM's record array and is
+ * not part of this table. Allowing vertical movement would either silently do
+ * nothing or require writing somewhere this table does not own, so the drag is
+ * limited to what the data actually supports.
+ *
+ * Cells with no storage - the pedal positions where a given curve has no vertex -
+ * are skipped entirely rather than drawn as points at zero, which would put a
+ * false corner in the line.
+ *
+ * Edits go through DataCell.setRealValue, so they respect the table's scaling,
+ * user level and lock state, and land in RomRaider's normal undo and save path.
+ * That is also why the checksum is corrected on save without this class knowing
+ * anything about checksums.
+ */
+public class ShiftCurveEditor extends JPanel {
+
+    private static final long serialVersionUID = 1L;
+
+    private static final int PAD_L = 62;
+    private static final int PAD_R = 132;
+    private static final int PAD_T = 34;
+    private static final int PAD_B = 46;
+    private static final int GRAB = 7;       // pixels within which a point is grabbed
+
+    private static final Color BG = new Color(24, 26, 30);
+    private static final Color GRID = new Color(52, 56, 64);
+    private static final Color AXIS = new Color(150, 156, 168);
+    private static final Color TEXT = new Color(226, 230, 238);
+
+    // Upshifts warm, downshifts cool, so a matching pair reads at a glance.
+    private static final Color[] SERIES = {
+        new Color(255, 92, 92), new Color(255, 158, 66),
+        new Color(255, 214, 74), new Color(140, 220, 96),
+        new Color(96, 190, 255), new Color(120, 150, 255),
+        new Color(168, 128, 255), new Color(226, 120, 226),
+    };
+
+    private final Table3D table;
+    private double speedMax = 140.0;
+
+    /** A draggable vertex: which cell it is, and where it sits on the chart. */
+    private static final class Vertex {
+        int col;                // index along the table's X axis (pedal position)
+        int row;                // shift event
+        double pedal;           // %
+        double speed;           // km/h
+        int px, py;
+    }
+
+    private final List<Vertex> vertices = new ArrayList<Vertex>();
+    private Vertex dragging;
+    private Vertex hover;
+
+    public ShiftCurveEditor(Table3D table) {
+        this.table = table;
+        setBackground(BG);
+        setPreferredSize(new Dimension(880, 560));
+        ToolTipManager.sharedInstance().registerComponent(this);
+
+        addMouseListener(new MouseAdapter() {
+            @Override
+            public void mousePressed(MouseEvent e) {
+                dragging = nearest(e.getX(), e.getY());
+                repaint();
+            }
+
+            @Override
+            public void mouseReleased(MouseEvent e) {
+                dragging = null;
+                repaint();
+            }
+        });
+
+        addMouseMotionListener(new MouseMotionAdapter() {
+            @Override
+            public void mouseDragged(MouseEvent e) {
+                if (dragging == null) {
+                    return;
+                }
+                // Horizontal only - see the class comment.
+                double v = xToSpeed(e.getX());
+                if (v < 0) {
+                    v = 0;
+                }
+                if (v > speedMax) {
+                    v = speedMax;
+                }
+                commit(dragging, v);
+                rebuild();
+                repaint();
+            }
+
+            @Override
+            public void mouseMoved(MouseEvent e) {
+                Vertex h = nearest(e.getX(), e.getY());
+                if (h != hover) {
+                    hover = h;
+                    repaint();
+                }
+            }
+        });
+
+        rebuild();
+    }
+
+    /** Re-read every vertex from the table, so the chart always shows live data. */
+    private void rebuild() {
+        vertices.clear();
+        final DataCell[][] data = table.get3dData();
+        final int cols = table.getSizeX();
+        final int rows = table.getSizeY();
+        double max = 60.0;
+
+        for (int row = 0; row < rows; row++) {
+            for (int col = 0; col < cols; col++) {
+                final DataCell cell = data[col][row];
+                if (cell == null || cell.getStaticText() != null) {
+                    continue;       // no storage here; not a point on the curve
+                }
+                final Vertex v = new Vertex();
+                v.col = col;
+                v.row = row;
+                v.speed = cell.getRealValue();
+                v.pedal = axisValue(col);
+                vertices.add(v);
+                if (v.speed > max) {
+                    max = v.speed;
+                }
+            }
+        }
+        // Round the axis up so the busiest curve is not jammed against the edge.
+        speedMax = Math.ceil((max * 1.08) / 20.0) * 20.0;
+    }
+
+    /** The X axis holds the pedal position as static label text. */
+    private double axisValue(int col) {
+        try {
+            final DataCell c = table.getXAxis().getData()[col];
+            final String s = c.getStaticText();
+            return s != null ? Double.parseDouble(s.trim()) : c.getRealValue();
+        } catch (Exception e) {
+            return 0.0;
+        }
+    }
+
+    private String rowLabel(int row) {
+        try {
+            final DataCell c = table.getYAxis().getData()[row];
+            final String s = c.getStaticText();
+            return s != null ? s : String.valueOf(row + 1);
+        } catch (Exception e) {
+            return String.valueOf(row + 1);
+        }
+    }
+
+    private void commit(Vertex v, double speed) {
+        final DataCell cell = table.get3dData()[v.col][v.row];
+        try {
+            // Through setRealValue so scaling, user level and locking all apply,
+            // and the change joins the normal undo/save path.
+            cell.setRealValue(String.valueOf(Math.round(speed)));
+        } catch (UserLevelException ex) {
+            // The table is above the user's level; leave the value alone.
+        }
+    }
+
+    private int speedToX(double v) {
+        return (int) Math.round(PAD_L + (v / speedMax) * (getWidth() - PAD_L - PAD_R));
+    }
+
+    private double xToSpeed(int px) {
+        final double w = getWidth() - PAD_L - PAD_R;
+        return w <= 0 ? 0 : (px - PAD_L) / w * speedMax;
+    }
+
+    private int pedalToY(double p) {
+        return (int) Math.round(getHeight() - PAD_B - (p / 100.0) * (getHeight() - PAD_T - PAD_B));
+    }
+
+    private Vertex nearest(int px, int py) {
+        Vertex best = null;
+        int bestDist = GRAB * GRAB;
+        for (Vertex v : vertices) {
+            final int dx = v.px - px;
+            final int dy = v.py - py;
+            final int d = dx * dx + dy * dy;
+            if (d <= bestDist) {
+                bestDist = d;
+                best = v;
+            }
+        }
+        return best;
+    }
+
+    @Override
+    public String getToolTipText(MouseEvent e) {
+        final Vertex v = nearest(e.getX(), e.getY());
+        return v == null ? null
+                : String.format("%s: %.0f km/h at %.1f%% pedal",
+                                rowLabel(v.row), v.speed, v.pedal);
+    }
+
+    @Override
+    protected void paintComponent(Graphics g0) {
+        super.paintComponent(g0);
+        final Graphics2D g = (Graphics2D) g0;
+        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
+                           RenderingHints.VALUE_ANTIALIAS_ON);
+        g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING,
+                           RenderingHints.VALUE_TEXT_ANTIALIAS_LCD_HRGB);
+
+        final int w = getWidth();
+        final int h = getHeight();
+        g.setColor(BG);
+        g.fillRect(0, 0, w, h);
+
+        // grid + axes
+        g.setColor(GRID);
+        for (int s = 0; s <= speedMax; s += 20) {
+            final int x = speedToX(s);
+            g.drawLine(x, PAD_T, x, h - PAD_B);
+        }
+        for (int p = 0; p <= 100; p += 10) {
+            final int y = pedalToY(p);
+            g.drawLine(PAD_L, y, w - PAD_R, y);
+        }
+        g.setColor(AXIS);
+        g.drawLine(PAD_L, h - PAD_B, w - PAD_R, h - PAD_B);
+        g.drawLine(PAD_L, PAD_T, PAD_L, h - PAD_B);
+
+        g.setColor(TEXT);
+        for (int s = 0; s <= speedMax; s += 20) {
+            final String t = String.valueOf(s);
+            g.drawString(t, speedToX(s) - g.getFontMetrics().stringWidth(t) / 2, h - PAD_B + 16);
+        }
+        for (int p = 0; p <= 100; p += 10) {
+            g.drawString(String.valueOf(p), 24, pedalToY(p) + 4);
+        }
+        g.drawString("Vehicle speed (km/h)", (PAD_L + w - PAD_R) / 2 - 56, h - 12);
+        g.drawString("Pedal %", 12, PAD_T - 12);
+        // Centred, and clear of the pedal label in the top-left corner.
+        final String title = table.getName();
+        g.drawString(title, (PAD_L + w - PAD_R) / 2 - g.getFontMetrics().stringWidth(title) / 2, 20);
+
+        // curves, one per shift event
+        final Stroke line = new BasicStroke(2.2f, BasicStroke.CAP_ROUND,
+                                            BasicStroke.JOIN_ROUND);
+        final int rows = table.getSizeY();
+        for (int row = 0; row < rows; row++) {
+            final Color c = SERIES[row % SERIES.length];
+            final List<Vertex> pts = new ArrayList<Vertex>();
+            for (Vertex v : vertices) {
+                if (v.row == row) {
+                    v.px = speedToX(v.speed);
+                    v.py = pedalToY(v.pedal);
+                    pts.add(v);
+                }
+            }
+            g.setColor(c);
+            g.setStroke(line);
+            for (int i = 0; i < pts.size() - 1; i++) {
+                g.drawLine(pts.get(i).px, pts.get(i).py,
+                           pts.get(i + 1).px, pts.get(i + 1).py);
+            }
+            for (Vertex v : pts) {
+                final boolean active = (v == dragging || v == hover);
+                final int r = active ? 5 : 3;
+                g.fillOval(v.px - r, v.py - r, r * 2, r * 2);
+                if (active) {
+                    g.setColor(Color.WHITE);
+                    g.drawOval(v.px - r - 2, v.py - r - 2, (r + 2) * 2, (r + 2) * 2);
+                    g.setColor(c);
+                }
+            }
+            // legend
+            final int ly = PAD_T + 8 + row * 17;
+            g.fillRect(w - PAD_R + 12, ly, 18, 3);
+            g.setColor(TEXT);
+            g.drawString(rowLabel(row), w - PAD_R + 36, ly + 6);
+        }
+
+        if (dragging != null) {
+            g.setColor(TEXT);
+            g.drawString(String.format("%s  %.0f km/h @ %.1f%%",
+                         rowLabel(dragging.row), dragging.speed, dragging.pedal),
+                         PAD_L + 8, PAD_T + 16);
+        }
+    }
+}
