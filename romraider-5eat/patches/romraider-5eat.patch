+package com.romraider.cli;
+
+import com.romraider.maps.DataCell;
+import com.romraider.maps.Rom;
+import com.romraider.maps.Table;
+import com.romraider.maps.Table3D;
+import com.romraider.swing.JProgressPane;
+import com.romraider.util.SettingsManager;
+import com.romraider.xml.DOMRomUnmarshaller;
+import org.w3c.dom.Node;
+
+import javax.xml.parsers.DocumentBuilderFactory;
+import java.io.File;
+import java.io.PrintStream;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * A batch interface to the parts of RomRaider that do not need a window.
+ *
+ * WHY THIS EXISTS. Checking that a definition is right meant writing a throwaway
+ * Java harness each time, compiling it against the jar, and running it with a display
+ * attached because the save path touched Swing. That is slow, and worse, every
+ * harness was slightly different, so the thing being tested kept changing.
+ *
+ * This runs headless, prints one JSON object per invocation, and returns a non-zero
+ * exit status when the answer is "no". That makes it usable from a script, from CI,
+ * or by anything else that has to check a ROM without a human watching.
+ *
+ * IT DRIVES THE REAL CODE. Tables are read through DOMRomUnmarshaller and written
+ * through DataCell.setRealValue, and saving goes through Rom.saveFile, which is what
+ * the Save button calls and what applies the checksums. A test that reimplemented
+ * any of that would prove nothing about the application.
+ *
+ *   RomRaider-TCU.exe --cli info      &lt;def.xml&gt; &lt;rom.bin&gt;
+ *   RomRaider-TCU.exe --cli tables    &lt;def.xml&gt; &lt;rom.bin&gt; [substring]
+ *   RomRaider-TCU.exe --cli dump      &lt;def.xml&gt; &lt;rom.bin&gt; &lt;table name&gt;
+ *   RomRaider-TCU.exe --cli checksum  &lt;def.xml&gt; &lt;rom.bin&gt; [--fix &lt;out.bin&gt;]
+ *   RomRaider-TCU.exe --cli set       &lt;def.xml&gt; &lt;rom.bin&gt; &lt;table&gt; &lt;index&gt; &lt;value&gt; &lt;out.bin&gt;
+ *   RomRaider-TCU.exe --cli selftest  &lt;def.xml&gt; &lt;rom.bin&gt;...
+ */
+public final class TcuCli {
+
+    private static final PrintStream OUT = System.out;
+
+    private TcuCli() { }
+
+    // ----------------------------------------------------------------- output
+
+    private static String esc(String s) {
+        if (s == null) {
+            return "null";
+        }
+        final StringBuilder b = new StringBuilder("\"");
+        for (char c : s.toCharArray()) {
+            switch (c) {
+                case '"':  b.append("\\\""); break;
+                case '\\': b.append("\\\\"); break;
+                case '\n': b.append("\\n");  break;
+                case '\r': b.append("\\r");  break;
+                case '\t': b.append("\\t");  break;
+                default:
+                    if (c < 0x20) {
+                        b.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        b.append(c);
+                    }
+            }
+        }
+        return b.append('"').toString();
+    }
+
+    /** Root cause plus where it came from - a bare type name is not actionable. */
+    private static String describe(Throwable t) {
+        Throwable c = t;
+        while (c.getCause() != null) {
+            c = c.getCause();
+        }
+        final StringBuilder b = new StringBuilder(c.getClass().getSimpleName());
+        if (c.getMessage() != null) {
+            b.append(": ").append(c.getMessage());
+        }
+        final StackTraceElement[] st = c.getStackTrace();
+        for (int i = 0; i < Math.min(4, st.length); i++) {
+            b.append(i == 0 ? " at " : " <- ").append(st[i]);
+        }
+        return b.toString();
+    }
+
+    private static int fail(String message) {
+        OUT.println("{\"ok\":false,\"error\":" + esc(message) + "}");
+        return 1;
+    }
+
+    // ------------------------------------------------------------------ model
+
+    /** Load a ROM against a definition, or return null having printed why not. */
+    private static Rom load(String defPath, String romPath) throws Exception {
+        final File def = new File(defPath);
+        if (!def.isFile()) {
+            fail("definition not found: " + defPath);
+            return null;
+        }
+        final File romFile = new File(romPath);
+        if (!romFile.isFile()) {
+            fail("rom not found: " + romPath);
+            return null;
+        }
+        final byte[] bin = Files.readAllBytes(romFile.toPath());
+
+        final DocumentBuilderFactory f = DocumentBuilderFactory.newInstance();
+        f.setNamespaceAware(false);
+        final Node root = f.newDocumentBuilder().parse(def).getDocumentElement();
+
+        final DOMRomUnmarshaller u = new DOMRomUnmarshaller();
+        final Node match = u.checkDefinitionMatch(root, bin);
+        if (match == null) {
+            fail("no definition in " + def.getName() + " matches " + romFile.getName());
+            return null;
+        }
+        final Rom rom = u.unmarshallXMLDefinition(def, root, match, bin, new JProgressPane());
+        rom.populateTables(bin, new JProgressPane());
+        return rom;
+    }
+
+    /**
+     * Every cell of a table, whatever its shape.
+     *
+     * Table3D keeps its cells in a two-dimensional array and leaves the flat one
+     * inherited from Table empty, so reading getData() alone reports a 3D table as
+     * having no cells at all - which is what made the first run of this report every
+     * Denso image as having nothing writable.
+     */
+    private static DataCell[] cellsOf(Table t) {
+        if (t instanceof Table3D) {
+            final DataCell[][] grid = ((Table3D) t).get3dData();
+            if (grid == null || grid.length == 0) {
+                return new DataCell[0];
+            }
+            final List<DataCell> flat = new ArrayList<DataCell>();
+            for (DataCell[] col : grid) {
+                if (col != null) {
+                    for (DataCell c : col) {
+                        flat.add(c);
+                    }
+                }
+            }
+            return flat.toArray(new DataCell[0]);
+        }
+        final DataCell[] d = t.getData();
+        return d == null ? new DataCell[0] : d;
+    }
+
+    private static Table find(Rom rom, String name) {
+        Table exact = null, partial = null;
+        for (Table t : rom.getTables()) {
+            if (t.getName().equals(name)) {
+                exact = t;
+                break;
+            }
+            if (partial == null && t.getName().toLowerCase().contains(name.toLowerCase())) {
+                partial = t;
+            }
+        }
+        return exact != null ? exact : partial;
+    }
+
+    // --------------------------------------------------------------- commands
+
+    private static int info(String[] a) throws Exception {
+        final Rom rom = load(a[0], a[1]);
+        if (rom == null) {
+            return 1;
+        }
+        int cs = rom.validateChecksum();
+        OUT.println("{\"ok\":true,\"xmlid\":" + esc(rom.getRomID().getXmlid())
+                + ",\"tables\":" + rom.getTables().size()
+                + ",\"checksumsValid\":" + cs
+                + ",\"checksumsTotal\":" + rom.getTotalAmountOfChecksums()
+                + ",\"checksumOk\":" + (cs == rom.getTotalAmountOfChecksums()) + "}");
+        return cs == rom.getTotalAmountOfChecksums() ? 0 : 1;
+    }
+
+    private static int tables(String[] a) throws Exception {
+        final Rom rom = load(a[0], a[1]);
+        if (rom == null) {
+            return 1;
+        }
+        final String filter = a.length > 2 ? a[2].toLowerCase() : null;
+        final StringBuilder b = new StringBuilder("{\"ok\":true,\"tables\":[");
+        boolean first = true;
+        for (Table t : rom.getTables()) {
+            if (filter != null && !t.getName().toLowerCase().contains(filter)) {
+                continue;
+            }
+            if (!first) {
+                b.append(',');
+            }
+            first = false;
+            b.append("{\"name\":").append(esc(t.getName()))
+             .append(",\"type\":").append(esc(String.valueOf(t.getType())))
+             .append(",\"category\":").append(esc(t.getCategory()))
+             .append(",\"address\":").append(t.getStorageAddress()).append('}');
+        }
+        OUT.println(b.append("]}").toString());
+        return 0;
+    }
+
+    private static int dump(String[] a) throws Exception {
+        final Rom rom = load(a[0], a[1]);
+        if (rom == null) {
+            return 1;
+        }
+        final Table t = find(rom, a[2]);
+        if (t == null) {
+            return fail("no table matching: " + a[2]);
+        }
+        final DataCell[] cells = cellsOf(t);
+        final StringBuilder b = new StringBuilder("{\"ok\":true,\"name\":");
+        b.append(esc(t.getName())).append(",\"type\":")
+         .append(esc(String.valueOf(t.getType())))
+         .append(",\"cells\":").append(cells == null ? 0 : cells.length)
+         .append(",\"values\":[");
+        if (cells != null) {
+            for (int i = 0; i < cells.length; i++) {
+                if (i > 0) {
+                    b.append(',');
+                }
+                final DataCell c = cells[i];
+                if (c == null || c.getStaticText() != null) {
+                    b.append("null");
+                } else {
+                    b.append(c.getRealValue());
+                }
+            }
+        }
+        OUT.println(b.append("]}").toString());
+        return 0;
+    }
+
+    private static int checksum(String[] a) throws Exception {
+        final Rom rom = load(a[0], a[1]);
+        if (rom == null) {
+            return 1;
+        }
+        final int total = rom.getTotalAmountOfChecksums();
+        final int before = rom.validateChecksum();
+
+        String out = null;
+        for (int i = 2; i < a.length - 1; i++) {
+            if ("--fix".equals(a[i])) {
+                out = a[i + 1];
+            }
+        }
+        int fixed = -1, after = before;
+        if (out != null) {
+            fixed = rom.updateChecksum();
+            after = rom.validateChecksum();
+            Files.write(Paths.get(out), rom.getBinary());
+        }
+        OUT.println("{\"ok\":" + (after == total) + ",\"total\":" + total
+                + ",\"validBefore\":" + before + ",\"validAfter\":" + after
+                + ",\"fixed\":" + fixed
+                + (out == null ? "" : ",\"wrote\":" + esc(out)) + "}");
+        return after == total ? 0 : 1;
+    }
+
+    private static int set(String[] a) throws Exception {
+        if (a.length < 6) {
+            return fail("set needs <def> <rom> <table> <index> <value> <out>");
+        }
+        final Rom rom = load(a[0], a[1]);
+        if (rom == null) {
+            return 1;
+        }
+        final Table t = find(rom, a[2]);
+        if (t == null) {
+            return fail("no table matching: " + a[2]);
+        }
+        final int idx = Integer.parseInt(a[3]);
+        final DataCell[] cells = cellsOf(t);
+        if (cells == null || idx < 0 || idx >= cells.length) {
+            return fail("index " + idx + " out of range for "
+                    + (cells == null ? 0 : cells.length) + " cells");
+        }
+        final DataCell cell = cells[idx];
+        if (cell == null || cell.getStaticText() != null) {
+            return fail("cell " + idx + " is a placeholder and has no storage");
+        }
+        final double was = cell.getRealValue();
+        cell.setRealValue(a[4]);
+        final byte[] saved = rom.saveFile();
+        Files.write(Paths.get(a[5]), saved);
+
+        OUT.println("{\"ok\":true,\"table\":" + esc(t.getName())
+                + ",\"index\":" + idx + ",\"was\":" + was
+                + ",\"now\":" + cell.getRealValue()
+                + ",\"checksumsValid\":" + rom.validateChecksum()
+                + ",\"checksumsTotal\":" + rom.getTotalAmountOfChecksums()
+                + ",\"wrote\":" + esc(a[5]) + "}");
+        return 0;
+    }
+
+    /**
+     * The check worth running over a whole family: for every ROM, load it, confirm
+     * the checksums are right as shipped, open every table, edit the first writable
+     * cell, save, and confirm the checksums are right again.
+     */
+    private static int selftest(String[] a) throws Exception {
+        final List<String> defs = new ArrayList<String>();
+        final List<String> roms = new ArrayList<String>();
+
+        if (a.length == 0) {
+            // No arguments is the useful default: check this installation against
+            // everything it ships with. Nothing is written — saveFile() works on a
+            // copy held in memory — so this is safe to run against the bundled ROMs.
+            final File base = bundleDir();
+            collect(base == null ? null : new File(base, "definitions"), ".xml", defs);
+            collect(base == null ? null : new File(base, "roms"), ".bin", roms);
+            if (defs.isEmpty() || roms.isEmpty()) {
+                return fail("no bundled definitions or ROMs found"
+                        + (base == null ? "" : " under " + base.getPath())
+                        + "; give <def> <rom>... explicitly");
+            }
+        } else if (a.length < 2) {
+            return fail("selftest needs <def> <rom>..., or no arguments to check the bundled set");
+        } else {
+            defs.add(a[0]);
+            for (int i = 1; i < a.length; i++) {
+                roms.add(a[i]);
+            }
+        }
+
+        final List<String> bad = new ArrayList<String>();
+        final StringBuilder b = new StringBuilder("{\"results\":[");
+
+        for (int i = 0; i < roms.size(); i++) {
+            final String path = roms.get(i);
+            final String name = new File(path).getName();
+            if (i > 0) {
+                b.append(',');
+            }
+            try {
+                // Where several definitions are available, the right one is whichever
+                // recognises the image: the two families share no identifiers.
+                Rom rom = null;
+                for (String def : defs) {
+                    rom = new RomLoad(def, path).rom;
+                    if (rom != null) {
+                        break;
+                    }
+                }
+                if (rom == null) {
+                    bad.add(name + ": no match");
+                    b.append("{\"rom\":").append(esc(name)).append(",\"ok\":false,\"error\":\"no match\"}");
+                    continue;
+                }
+                final int total = rom.getTotalAmountOfChecksums();
+                final int loaded = rom.validateChecksum();
+
+                int opened = 0;
+                for (Table t : rom.getTables()) {
+                    if (cellsOf(t).length > 0) {
+                        opened++;
+                    }
+                }
+
+                DataCell target = null;
+                for (Table t : rom.getTables()) {
+                    final DataCell[] cells = cellsOf(t);
+                    if (cells == null) {
+                        continue;
+                    }
+                    for (DataCell c : cells) {
+                        if (c != null && c.getStaticText() == null) {
+                            target = c;
+                            break;
+                        }
+                    }
+                    if (target != null) {
+                        break;
+                    }
+                }
+                int after = loaded;
+                if (target != null) {
+                    target.setRealValue(String.valueOf(target.getRealValue() + 1));
+                    rom.saveFile();
+                    after = rom.validateChecksum();
+                }
+                final boolean ok = loaded == total && after == total && target != null;
+                if (!ok) {
+                    bad.add(name);
+                }
+                b.append("{\"rom\":").append(esc(name)).append(",\"ok\":").append(ok)
+                 .append(",\"tables\":").append(opened)
+                 .append(",\"checksumsTotal\":").append(total)
+                 .append(",\"validAsLoaded\":").append(loaded)
+                 .append(",\"validAfterEdit\":").append(after).append('}');
+            } catch (Throwable t) {
+                bad.add(name + ": " + describe(t));
+                b.append("{\"rom\":").append(esc(name))
+                 .append(",\"ok\":false,\"error\":").append(esc(describe(t))).append('}');
+            }
+        }
+        b.append("],\"ok\":").append(bad.isEmpty()).append(",\"failed\":").append(bad.size()).append('}');
+        OUT.println(b.toString());
+        return bad.isEmpty() ? 0 : 1;
+    }
+
+    /**
+     * The directory the application was installed into, or null if that cannot be
+     * worked out. The jar sits alongside the definitions and roms directories, so
+     * its own location is what locates them.
+     */
+    private static File bundleDir() {
+        try {
+            final File jar = new File(TcuCli.class.getProtectionDomain()
+                    .getCodeSource().getLocation().toURI());
+            final File dir = jar.isFile() ? jar.getParentFile() : jar;
+            if (dir != null && new File(dir, "definitions").isDirectory()) {
+                return dir;
+            }
+        } catch (Throwable ignored) {
+            // No resolvable code source; fall through to the working directory.
+        }
+        final File cwd = new File("").getAbsoluteFile();
+        return new File(cwd, "definitions").isDirectory() ? cwd : null;
+    }
+
+    /** Every file in dir ending in ext, sorted by path, appended to out. */
+    private static void collect(File dir, String ext, List<String> out) {
+        if (dir == null || !dir.isDirectory()) {
+            return;
+        }
+        final File[] found = dir.listFiles();
+        if (found == null) {
+            return;
+        }
+        final List<String> names = new ArrayList<String>();
+        for (File f : found) {
+            if (f.isFile() && f.getName().toLowerCase().endsWith(ext)) {
+                names.add(f.getAbsolutePath());
+            }
+        }
+        java.util.Collections.sort(names);
+        out.addAll(names);
+    }
+
+    /** Loading without printing an error, for selftest's per-ROM reporting. */
+    private static final class RomLoad {
+        final Rom rom;
+        RomLoad(String def, String romPath) throws Exception {
+            final byte[] bin = Files.readAllBytes(Paths.get(romPath));
+            final DocumentBuilderFactory f = DocumentBuilderFactory.newInstance();
+            f.setNamespaceAware(false);
+            final Node root = f.newDocumentBuilder().parse(new File(def)).getDocumentElement();
+            final DOMRomUnmarshaller u = new DOMRomUnmarshaller();
+            final Node match = u.checkDefinitionMatch(root, bin);
+            if (match == null) {
+                rom = null;
+                return;
+            }
+            final Rom r = u.unmarshallXMLDefinition(new File(def), root, match, bin,
+                    new JProgressPane());
+            r.populateTables(bin, new JProgressPane());
+            rom = r;
+        }
+    }
+
+    // ------------------------------------------------------------------- main
+
+    private static final String USAGE =
+            "usage: --cli <command> <definition.xml> <rom.bin> [...]\n"
+          + "  info      <def> <rom>                        identity, table count, checksum state\n"
+          + "  tables    <def> <rom> [substring]            list tables as JSON\n"
+          + "  dump      <def> <rom> <table>                cell values as JSON\n"
+          + "  checksum  <def> <rom> [--fix <out.bin>]      report, and optionally correct\n"
+          + "  set       <def> <rom> <table> <i> <v> <out>  edit one cell and save\n"
+          + "  selftest [<def> <rom>...]                    load, edit, save, re-check each ROM\n"
+          + "                                               (no arguments: the bundled set)\n"
+          + "\nPrints one JSON object. Exit status is 0 only when the answer is yes.";
+
+    public static int run(String[] argv) {
+        // Nothing here needs a display, and saying so avoids pulling in a toolkit.
+        System.setProperty("java.awt.headless", "true");
+
+        // Keep stdout to nothing but the JSON. log4j's default console appender
+        // writes to stdout, so a single INFO line about loading settings.xml lands
+        // in the middle of the output and breaks anything parsing it. Diagnostics
+        // belong on stderr.
+        org.apache.log4j.LogManager.resetConfiguration();
+        final org.apache.log4j.ConsoleAppender err = new org.apache.log4j.ConsoleAppender(
+                new org.apache.log4j.SimpleLayout(), org.apache.log4j.ConsoleAppender.SYSTEM_ERR);
+        org.apache.log4j.BasicConfigurator.configure(err);
+        org.apache.log4j.Logger.getRootLogger().setLevel(org.apache.log4j.Level.WARN);
+
+        SettingsManager.setTesting(true);
+
+        if (argv.length == 0 || "-h".equals(argv[0]) || "--help".equals(argv[0])) {
+            OUT.println(USAGE);
+            return argv.length == 0 ? 2 : 0;
+        }
+        final String cmd = argv[0];
+        final String[] rest = new String[argv.length - 1];
+        System.arraycopy(argv, 1, rest, 0, rest.length);
+
+        try {
+            if (rest.length < 2 && !"selftest".equals(cmd)) {
+                return fail("command '" + cmd + "' needs a definition and a ROM");
+            }
+            if ("info".equals(cmd))     return info(rest);
+            if ("tables".equals(cmd))   return tables(rest);
+            if ("dump".equals(cmd))     return dump(rest);
+            if ("checksum".equals(cmd)) return checksum(rest);
+            if ("set".equals(cmd))      return set(rest);
+            if ("selftest".equals(cmd)) return selftest(rest);
+            return fail("unknown command: " + cmd);
+        } catch (Throwable t) {
+            // Say WHERE it failed, not just what. An error that reports only its
+            // type sends the reader hunting through the whole load path.
+            return fail(describe(t));
+        }
+    }
+
+    public static void main(String[] args) {
+        System.exit(run(args));
+    }
+}
