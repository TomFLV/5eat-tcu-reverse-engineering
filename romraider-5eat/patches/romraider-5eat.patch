 import org.apache.log4j.Logger;
@@ -51,17 +52,72 @@ public final class LookAndFeelManager {
 
             setLookAndFeel(getLookAndFeel());
 
-            // make sure we have nice window decorations.
-            JFrame.setDefaultLookAndFeelDecorated(true);
-            JDialog.setDefaultLookAndFeelDecorated(true);
+            // Use a modern UI font. Much of this codebase hardcodes Tahoma 11,
+            // a 2001-era font; where the look and feel font is honoured, prefer
+            // Segoe UI, falling back if it is not installed.
+            applyModernFont();
+
+            // FlatLaf provides its own window decorations and handles HiDPI itself;
+            // forcing LAF decoration on top of it produces blurry, mismatched frames.
+            final boolean flat = UIManager.getLookAndFeel() != null
+                    && UIManager.getLookAndFeel().getClass().getName().startsWith("com.formdev.flatlaf");
+            JFrame.setDefaultLookAndFeelDecorated(!flat);
+            JDialog.setDefaultLookAndFeelDecorated(!flat);
 
         } catch (Exception ex) {
             LOGGER.error("Error loading system look and feel.", ex);
         }
     }
 
+    /**
+     * Look and feel selection.
+     *
+     * Prefers FlatLaf when it is on the classpath: it renders correctly on HiDPI
+     * displays, where the Windows look and feel is bitmap-scaled and looks blurry.
+     * Set -Dromraider.theme=light for the light variant, or =system to force the
+     * previous behaviour. Falls back to the old selection if FlatLaf is absent, so
+     * the build works with or without the jar.
+     */
+    /**
+     * Sets a modern default UI font when one is available.
+     *
+     * Only affects components that read UIManager rather than constructing their
+     * own Font. Text crispness itself is handled by the antialiasing properties
+     * set in main(), not here.
+     */
+    private static void applyModernFont() {
+        final String[] preferred = {"Segoe UI", "Inter", "Roboto", "Dialog"};
+        final java.util.Set<String> available = new java.util.HashSet<String>(
+                java.util.Arrays.asList(java.awt.GraphicsEnvironment
+                        .getLocalGraphicsEnvironment().getAvailableFontFamilyNames()));
+        String chosen = null;
+        for (String f : preferred) {
+            if (available.contains(f)) { chosen = f; break; }
+        }
+        if (chosen == null) return;
+        final javax.swing.plaf.FontUIResource font =
+                new javax.swing.plaf.FontUIResource(chosen, java.awt.Font.PLAIN, 12);
+        for (Object key : java.util.Collections.list(UIManager.getDefaults().keys())) {
+            if (UIManager.get(key) instanceof javax.swing.plaf.FontUIResource) {
+                UIManager.put(key, font);
+            }
+        }
+        LOGGER.info("UI font set to " + chosen);
+    }
+
     private static String getLookAndFeel() {
-//        if (true) return "com.sun.java.swing.plaf.nimbus.NimbusLookAndFeel";
+        final String theme = System.getProperty("romraider.theme", "dark");
+        if (!"system".equalsIgnoreCase(theme)) {
+            final String laf = "light".equalsIgnoreCase(theme)
+                    ? "com.formdev.flatlaf.FlatLightLaf"
+                    : "com.formdev.flatlaf.FlatDarkLaf";
+            try {
+                Class.forName(laf);
+                return laf;
+            } catch (ClassNotFoundException e) {
+                LOGGER.info("FlatLaf not on classpath; using the platform look and feel.");
+            }
+        }
         // Linux has issues with the gtk look and feel themes.
         if (isPlatform(LINUX)) return getCrossPlatformLookAndFeelClassName();
         return getSystemLookAndFeelClassName();
