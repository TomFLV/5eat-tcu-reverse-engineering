+package com.romraider.maps.checksum;
+
+import java.util.Map;
+
+/**
+ * Checksum for the Subaru 5EAT transmission control unit (Renesas M32R).
+ *
+ * A 32-bit big-endian two's-complement additive checksum, stored redundantly in
+ * two 4-byte slots at 0x008000 and 0x008004. Both hold the same value C, chosen
+ * so that summing every 32-bit big-endian word in the checksummed region - with
+ * both slots counted once as C - comes to zero modulo 2^32.
+ *
+ * THE REGION IS NOT FIXED. Two conventions occur across this TCU family:
+ *
+ *   0x60000     every 384 KB image, and 512 KB images carrying a 384 KB payload
+ *               with the trailing 128 KB left as blank 0xFF flash
+ *   whole file  512 KB images that genuinely populate all 512 KB
+ *
+ * Assuming either one produces a confidently wrong checksum on half the family,
+ * so the region is DETECTED per image: whichever candidate reproduces the value
+ * the ROM already stores is the convention that ROM uses. When the stored value
+ * matches neither - which is the normal state for a ROM that has just been
+ * edited - fall back on whether the tail past 0x60000 is unprogrammed, since a
+ * blank tail means the payload is 384 KB.
+ *
+ * Verified against twelve real images by tools/checksum.py in the project
+ * repository, which implements the same algorithm and is what this replaces.
+ */
+public final class ChecksumSUBARUTCU implements ChecksumManager {
+
+    private static final int SLOT_1 = 0x008000;
+    private static final int SLOT_2 = 0x008004;
+    private static final int REGION_384K = 0x60000;
+
+    @Override
+    public void configure(Map<String, String> vars) {
+        // Nothing to configure: the slots are fixed and the region is detected
+        // from the image itself, which is more reliable than trusting an
+        // attribute in the definition to match the image actually loaded.
+    }
+
+    @Override
+    public int getNumberOfChecksums() {
+        return 1;   // one value, stored twice
+    }
+
+    /**
+     * Enough bytes to hold both slots. RomRaider can ask a manager to validate
+     * before a binary has been attached, so a plugin must not assume otherwise.
+     */
+    private static boolean usable(byte[] data) {
+        return data != null && data.length >= SLOT_2 + 4;
+    }
+
+    @Override
+    public int validate(byte[] data) {
+        if (!usable(data)) {
+            return 0;
+        }
+        final long a = readU32(data, SLOT_1);
+        final long b = readU32(data, SLOT_2);
+        if (a != b) {
+            return 0;   // the two copies disagree, so neither can be trusted
+        }
+        return detectRegion(data) >= 0 ? 1 : 0;
+    }
+
+    @Override
+    public int update(byte[] data) {
+        if (!usable(data)) {
+            return 0;
+        }
+        final int end = chooseRegion(data);
+        final long want = computeFor(data, end);
+
+        if (readU32(data, SLOT_1) == want && readU32(data, SLOT_2) == want) {
+            return 0;   // already correct, nothing written
+        }
+
+        writeU32(data, SLOT_1, want);
+        writeU32(data, SLOT_2, want);
+        return 1;
+    }
+
+    /**
+     * The value both slots must hold for the region ending at {@code end} to sum
+     * to zero. The two slots are excluded from the running total and added back
+     * once, which is what makes the stored value self-consistent.
+     */
+    private static long computeFor(byte[] data, int end) {
+        long total = 0;
+        for (int i = 0; i + 4 <= end; i += 4) {
+            if (i == SLOT_1 || i == SLOT_2) {
+                continue;
+            }
+            total += readU32(data, i);
+        }
+        return (-total) & 0xFFFFFFFFL;
+    }
+
+    /** Region end whose checksum reproduces what the ROM stores, or -1. */
+    private static int detectRegion(byte[] data) {
+        final long stored = readU32(data, SLOT_1);
+        for (int end : candidates(data)) {
+            if (computeFor(data, end) == stored) {
+                return end;
+            }
+        }
+        return -1;
+    }
+
+    /**
+     * Region to write over. Prefer whatever the image already uses; once it has
+     * been edited the stored value matches nothing, so fall back on the shape of
+     * the image - an unprogrammed tail past 0x60000 means a 384 KB payload.
+     */
+    private static int chooseRegion(byte[] data) {
+        final int detected = detectRegion(data);
+        if (detected >= 0) {
+            return detected;
+        }
+        if (data.length > REGION_384K && isBlank(data, REGION_384K, data.length)) {
+            return REGION_384K;
+        }
+        return data.length & ~3;
+    }
+
+    private static int[] candidates(byte[] data) {
+        final int whole = data.length & ~3;
+        if (whole > REGION_384K) {
+            return new int[] { REGION_384K, whole };
+        }
+        return new int[] { whole };
+    }
+
+    private static boolean isBlank(byte[] data, int from, int to) {
+        for (int i = from; i < to; i++) {
+            if (data[i] != (byte) 0xFF) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static long readU32(byte[] d, int at) {
+        return ((long) (d[at] & 0xFF) << 24)
+             | ((long) (d[at + 1] & 0xFF) << 16)
+             | ((long) (d[at + 2] & 0xFF) << 8)
+             | ((long) (d[at + 3] & 0xFF));
+    }
+
+    private static void writeU32(byte[] d, int at, long v) {
+        d[at] = (byte) ((v >>> 24) & 0xFF);
+        d[at + 1] = (byte) ((v >>> 16) & 0xFF);
+        d[at + 2] = (byte) ((v >>> 8) & 0xFF);
+        d[at + 3] = (byte) (v & 0xFF);
+    }
+}
