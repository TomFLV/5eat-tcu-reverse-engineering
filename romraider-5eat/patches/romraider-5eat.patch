+ * with this program; if not, write to the Free Software Foundation, Inc.,
+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+ */
+
+package com.romraider.maps.checksum;
+
+import java.util.Map;
+
+/**
+ * Checksum for the Denso SH705x Subaru 5EAT transmission control unit.
+ *
+ * A DIFFERENT FAMILY from the Hitachi M32R 5EAT, which {@link ChecksumSUBARUTCU}
+ * handles. The two share nothing: different processor, different table format, and
+ * the scheme below rather than an additive checksum with a balance word.
+ *
+ * Denso protect these images the same way they protect their engine ECUs. A table
+ * near the end of the image lists the regions covered, as consecutive triples:
+ *
+ *     0xFFB80   uint32  first address of the block
+ *     0xFFB84   uint32  last address of the block, inclusive
+ *     0xFFB88   uint32  balance
+ *
+ * repeating for as many blocks as the image protects. Summing every 32-bit
+ * big-endian word across a block and adding that block's balance must come to the
+ * constant 0x5AA5A55A.
+ *
+ * The balance lies outside the region it corrects - the table sits past the end of
+ * the last block - so unlike the M32R balance there is no circularity here and a
+ * block can be repaired in one pass, in any order.
+ *
+ * Verified against ten Denso 5EAT images, every one of which reports its blocks
+ * correct as shipped.
+ */
+public final class ChecksumSUBARUTCUDENSO implements ChecksumManager {
+
+    private static final int TABLE = 0xFFB80;
+    private static final int TRIPLE = 12;
+    private static final int MAX_BLOCKS = 8;
+    private static final long TARGET = 0x5AA5A55AL;
+
+    @Override
+    public void configure(Map<String, String> vars) {
+        // Nothing to configure: the table says which regions are covered, which is
+        // more reliable than an attribute in the definition matching the image.
+    }
+
+    @Override
+    public int getNumberOfChecksums() {
+        return 1;   // one per block, but the count is not known without the image
+    }
+
+    /** Blocks declared by the table: {start, end, balanceAddress} each. */
+    private static int[][] blocks(byte[] d) {
+        final int[][] found = new int[MAX_BLOCKS][];
+        int n = 0;
+        for (int i = 0; i < MAX_BLOCKS; i++) {
+            final int at = TABLE + i * TRIPLE;
+            if (at + TRIPLE > d.length) {
+                break;
+            }
+            final long start = readU32(d, at);
+            final long end = readU32(d, at + 4);
+            // A plausible block is ordered, inside the image, and not degenerate.
+            if (start >= end || end >= d.length || (end - start) < 4) {
+                break;
+            }
+            found[n++] = new int[] { (int) start, (int) end, at + 8 };
+        }
+        final int[][] out = new int[n][];
+        System.arraycopy(found, 0, out, 0, n);
+        return out;
+    }
+
+    /** Sum of every whole big-endian word from start to end inclusive. */
+    private static long sum(byte[] d, int start, int end) {
+        long total = 0;
+        for (int i = start; i + 4 <= end + 1; i += 4) {
+            total += readU32(d, i);
+        }
+        return total & 0xFFFFFFFFL;
+    }
+
+    private static boolean usable(byte[] d) {
+        return d != null && d.length > TABLE + TRIPLE;
+    }
+
+    @Override
+    public int validate(byte[] d) {
+        if (!usable(d)) {
+            return 0;
+        }
+        final int[][] bs = blocks(d);
+        if (bs.length == 0) {
+            return 0;
+        }
+        for (int[] b : bs) {
+            final long got = (sum(d, b[0], b[1]) + readU32(d, b[2])) & 0xFFFFFFFFL;
+            if (got != TARGET) {
+                return 0;
+            }
+        }
+        return 1;
+    }
+
+    @Override
+    public int update(byte[] d) {
+        if (!usable(d)) {
+            return 0;
+        }
+        int fixed = 0;
+        for (int[] b : blocks(d)) {
+            // The balance sits outside the block it corrects, so this converges
+            // immediately and blocks do not interact.
+            final long want = (TARGET - sum(d, b[0], b[1])) & 0xFFFFFFFFL;
+            if (readU32(d, b[2]) != want) {
+                writeU32(d, b[2], want);
+                fixed++;
+            }
+        }
+        return fixed;
+    }
+
+    private static long readU32(byte[] d, int at) {
+        return ((long) (d[at] & 0xFF) << 24)
+             | ((long) (d[at + 1] & 0xFF) << 16)
+             | ((long) (d[at + 2] & 0xFF) << 8)
+             | ((long) (d[at + 3] & 0xFF));
+    }
+
+    private static void writeU32(byte[] d, int at, long v) {
+        d[at] = (byte) ((v >>> 24) & 0xFF);
+        d[at + 1] = (byte) ((v >>> 16) & 0xFF);
+        d[at + 2] = (byte) ((v >>> 8) & 0xFF);
+        d[at + 3] = (byte) (v & 0xFF);
+    }
+}
