+    /**
+     * Definition files shipped with the application, if any.
+     *
+     * Looks for a "definitions" directory beside the jar, and one level up as
+     * well: a jpackage app-image puts the jar in app/ with the launcher above it,
+     * so the definitions directory sits next to the executable rather than next
+     * to the jar. Returns empty when running from a source build, which leaves
+     * the original behaviour untouched.
+     */
+    private static List<File> findBundledDefinitions() {
+        final List<File> found = new ArrayList<File>();
+        try {
+            final File jar = new File(ECUEditor.class.getProtectionDomain()
+                    .getCodeSource().getLocation().toURI());
+            final File base = jar.isFile() ? jar.getParentFile() : jar;
+            final File[] candidates = {
+                new File(base, "definitions"),
+                new File(base.getParentFile(), "definitions"),
+            };
+            for (File dir : candidates) {
+                if (!dir.isDirectory()) continue;
+                final File[] xml = dir.listFiles(new FilenameFilter() {
+                    @Override
+                    public boolean accept(File d, String name) {
+                        return name.toLowerCase().endsWith(".xml");
+                    }
+                });
+                if (xml != null && xml.length > 0) {
+                    for (File f : xml) found.add(f);
+                    break;
+                }
+            }
+        } catch (Exception e) {
+            LOGGER.debug("No bundled ECU definitions alongside the application", e);
+        }
+        return found;
+    }
