+    /**
+     * Colours taken from the active look and feel rather than hardcoded.
+     *
+     * This renderer previously used fixed light colours (Color.WHITE backgrounds,
+     * 220,220,255 for selection). Under a dark theme those produce unreadable
+     * combinations -- dark default text on a white panel, or panels that blend
+     * into each other. Deriving from UIManager keeps it correct under any theme.
+     */
+    private static Color uiColor(String key, Color fallback) {
+        final Color c = UIManager.getColor(key);
+        return c == null ? fallback : c;
+    }
+
+    private static Color treeBackground() {
+        return uiColor("Tree.background", uiColor("Panel.background", Color.WHITE));
+    }
+
+    private static Color selectionBackground() {
+        return uiColor("Tree.selectionBackground", new Color(220, 220, 255));
+    }
+
+    private static Color selectionBorder() {
+        return uiColor("Component.focusColor",
+                uiColor("Tree.selectionBorderColor", new Color(0, 0, 225)));
+    }
+
+    private static boolean isDark() {
+        final Color bg = treeBackground();
+        // perceived luminance; below the midpoint means a dark theme
+        return (0.299 * bg.getRed() + 0.587 * bg.getGreen() + 0.114 * bg.getBlue()) < 128;
+    }
+
+    /** Attention colour for the ROM header row, legible on light or dark. */
+    private static Color romHeaderBackground() {
+        return isDark() ? new Color(90, 40, 40) : new Color(255, 210, 210);
+    }
+
+    private static Color expertForeground() {
+        return isDark() ? new Color(255, 120, 120) : new Color(200, 60, 60);
+    }
+
+    /** The tree font, from the look and feel, so HiDPI scaling applies. */
+    private static Font treeFont(int style) {
+        final Font f = UIManager.getFont("Tree.font");
+        return f == null ? new Font(Font.SANS_SERIF, style, 12) : f.deriveFont(style);
+    }
