+package com.romraider.maps.checksum;
+
+import java.util.Map;
+
+/**
+ * Checksums for the Subaru 5EAT transmission control unit (Renesas M32R).
+ *
+ * EVERY IMAGE IN THIS FAMILY CARRIES TWO, and both must be correct or the TCU
+ * rejects the ROM. They are independent of each other and are stored apart.
+ *
+ * 1. THE ADDITIVE CHECKSUM, held twice at 0x008000 and 0x008004.
+ *
+ *    A 32-bit big-endian two's-complement additive checksum. Both slots hold the
+ *    same value C, chosen so that summing every 32-bit big-endian word in the
+ *    checksummed region - with both slots counted once as C - comes to zero
+ *    modulo 2^32.
+ *
+ *    THE REGION IS NOT FIXED. Two conventions occur across this family:
+ *
+ *      0x60000     every 384 KB image, and 512 KB images carrying a 384 KB
+ *                  payload with the trailing 128 KB left as blank 0xFF flash
+ *      whole file  512 KB images that genuinely populate all 512 KB
+ *
+ *    Assuming either one produces a confidently wrong checksum on half the
+ *    family, so the region is DETECTED per image.
+ *
+ * 2. THE BALANCE CHECKSUM, held at 0x008020.
+ *
+ *    The firmware's own routine, which is what settles the details, reads:
+ *
+ *        for (p = 0x8000; p < end; p++)
+ *            if (p < 0x8000 || p > 0x801f)    // skip 0x8000..0x801F
+ *                sum += *p;
+ *
+ *    so it sums 32-bit words from 0x008020 to the end of the same region the
+ *    additive checksum covers, and a balance word inside that range absorbs the
+ *    difference. TWO VARIANTS EXIST, and the firmware picks one:
+ *
+ *      32-bit  the full sum must equal 0x5AA5A55A. The balance is the whole
+ *              32-bit word at 0x008020.
+ *      16-bit  only the low half of the sum is tested, against 0x5AA5. The
+ *              balance is the HALFWORD at 0x008022, and 0x008020 stays zero.
+ *
+ *    Of the eleven images in the project repository three use the 32-bit variant
+ *    and eight the 16-bit one. Treating the 16-bit images as having no balance at
+ *    all - which is what the absence of a full 0x5AA5A55A sum looks like from the
+ *    outside - leaves eight of eleven ROMs failing their own integrity check after
+ *    any edit. The variant is decided structurally: the 16-bit images hold zero in
+ *    the halfword at 0x008020, the 32-bit images hold the top half of a balance
+ *    there, and that stays true after the ROM has been edited.
+ *
+ * Order matters and only works one way round. The balance sits INSIDE the region
+ * the additive checksum covers, but the additive slots at 0x008000 and 0x008004
+ * sit below 0x008020 and so fall OUTSIDE the balance region. Fixing the balance
+ * first and the additive checksum second converges in a single pass.
+ *
+ * Verified against every image in the project repository by tools/checksum.py,
+ * which implements the same algorithm and produces byte-identical results.
+ */
+public final class ChecksumSUBARUTCU implements ChecksumManager {
+
+    private static final int SLOT_1 = 0x008000;
+    private static final int SLOT_2 = 0x008004;
+    private static final int REGION_384K = 0x60000;
+
+    /** Balance word, and the constants the two variants test against. */
+    private static final int BALANCE = 0x008020;
+    private static final long BALANCE_TARGET_32 = 0x5AA5A55AL;
+    private static final int BALANCE_TARGET_16 = 0x5AA5;
+
+    @Override
+    public void configure(Map<String, String> vars) {
+        // Nothing to configure: the slots are fixed, and the region and the
+        // balance variant are read from the image itself, which is more reliable
+        // than trusting an attribute in the definition to match the image loaded.
+    }
+
+    @Override
+    public int getNumberOfChecksums() {
+        return 2;   // additive, and balance - every image in this family has both
+    }
+
+    /**
+     * Enough bytes to hold both structures. RomRaider can ask a manager to
+     * validate before a binary has been attached, so a plugin must not assume.
+     */
+    private static boolean usable(byte[] data) {
+        return data != null && data.length > BALANCE + 4;
+    }
+
+    /** True when this image uses the 16-bit balance variant. */
+    private static boolean isBalance16(byte[] data) {
+        return readU16(data, BALANCE) == 0;
+    }
+
+    @Override
+    public int validate(byte[] data) {
+        if (!usable(data)) {
+            return 0;
+        }
+        int correct = 0;
+
+        // Disagreeing copies mean neither can be trusted, so the additive
+        // checksum does not count as correct even if one of them matches.
+        if (readU32(data, SLOT_1) == readU32(data, SLOT_2) && detectRegion(data) >= 0) {
+            correct++;
+        }
+        if (balanceHolds(data, chooseRegion(data))) {
+            correct++;
+        }
+        return correct;
+    }
+
+    @Override
+    public int update(byte[] data) {
+        if (!usable(data)) {
+            return 0;
+        }
+        int fixed = 0;
+        final int end = chooseRegion(data);
+
+        // Balance first. It lives inside the region the additive checksum covers,
+        // so writing it afterwards would invalidate the value just computed.
+        if (!balanceHolds(data, end)) {
+            if (isBalance16(data)) {
+                writeU16(data, BALANCE + 2, (int) balanceFor16(data, end));
+            } else {
+                writeU32(data, BALANCE, balanceFor32(data, end));
+            }
+            fixed++;
+        }
+
+        final long want = computeFor(data, end);
+        if (readU32(data, SLOT_1) != want || readU32(data, SLOT_2) != want) {
+            writeU32(data, SLOT_1, want);
+            writeU32(data, SLOT_2, want);
+            fixed++;
+        }
+        return fixed;
+    }
+
+    /** Does the balance region already meet the constant for this image's variant? */
+    private static boolean balanceHolds(byte[] data, int end) {
+        final long sum = sumBalanceRegion(data, end);
+        return isBalance16(data)
+                ? (sum & 0xFFFFL) == BALANCE_TARGET_16
+                : sum == BALANCE_TARGET_32;
+    }
+
+    /** The firmware's loop: 32-bit words from 0x008020 to the end of the region. */
+    private static long sumBalanceRegion(byte[] data, int end) {
+        long total = 0;
+        for (int i = BALANCE; i + 4 <= end; i += 4) {
+            total += readU32(data, i);
+        }
+        return total & 0xFFFFFFFFL;
+    }
+
+    /** Whole-word balance that brings the region to 0x5AA5A55A. */
+    private static long balanceFor32(byte[] data, int end) {
+        final long without = (sumBalanceRegion(data, end) - readU32(data, BALANCE))
+                & 0xFFFFFFFFL;
+        return (BALANCE_TARGET_32 - without) & 0xFFFFFFFFL;
+    }
+
+    /**
+     * Halfword balance that brings the low 16 bits of the region to 0x5AA5.
+     * The high half of the word at 0x008020 is zero on these images and does not
+     * affect the low half of the sum, so only 0x008022 is touched.
+     */
+    private static long balanceFor16(byte[] data, int end) {
+        final long without = (sumBalanceRegion(data, end) - readU16(data, BALANCE + 2))
+                & 0xFFFFL;
+        return (BALANCE_TARGET_16 - without) & 0xFFFFL;
+    }
+
+    /**
+     * The value both additive slots must hold for the region ending at
+     * {@code end} to sum to zero. The two slots are excluded from the running
+     * total and added back once, which is what makes the stored value
+     * self-consistent.
+     */
+    private static long computeFor(byte[] data, int end) {
+        long total = 0;
+        for (int i = 0; i + 4 <= end; i += 4) {
+            if (i == SLOT_1 || i == SLOT_2) {
+                continue;
+            }
+            total += readU32(data, i);
+        }
+        return (-total) & 0xFFFFFFFFL;
+    }
+
+    /** Region end whose additive checksum reproduces what the ROM stores, or -1. */
+    private static int detectRegion(byte[] data) {
+        final long stored = readU32(data, SLOT_1);
+        for (int end : candidates(data)) {
+            if (computeFor(data, end) == stored) {
+                return end;
+            }
+        }
+        return -1;
+    }
+
+    /**
+     * Region to work over. Prefer whatever the image already uses; once it has
+     * been edited the stored value matches nothing, so fall back on the shape of
+     * the image - an unprogrammed tail past 0x60000 means a 384 KB payload.
+     */
+    private static int chooseRegion(byte[] data) {
+        final int detected = detectRegion(data);
+        if (detected >= 0) {
+            return detected;
+        }
+        if (data.length > REGION_384K && isBlank(data, REGION_384K, data.length)) {
+            return REGION_384K;
+        }
+        return data.length & ~3;
+    }
+
+    private static int[] candidates(byte[] data) {
+        final int whole = data.length & ~3;
+        if (whole > REGION_384K) {
+            return new int[] { REGION_384K, whole };
+        }
+        return new int[] { whole };
+    }
+
+    private static boolean isBlank(byte[] data, int from, int to) {
+        for (int i = from; i < to; i++) {
+            if (data[i] != (byte) 0xFF) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static long readU32(byte[] d, int at) {
+        return ((long) (d[at] & 0xFF) << 24)
+             | ((long) (d[at + 1] & 0xFF) << 16)
+             | ((long) (d[at + 2] & 0xFF) << 8)
+             | ((long) (d[at + 3] & 0xFF));
+    }
+
+    private static int readU16(byte[] d, int at) {
+        return ((d[at] & 0xFF) << 8) | (d[at + 1] & 0xFF);
+    }
+
+    private static void writeU32(byte[] d, int at, long v) {
+        d[at] = (byte) ((v >>> 24) & 0xFF);
+        d[at + 1] = (byte) ((v >>> 16) & 0xFF);
+        d[at + 2] = (byte) ((v >>> 8) & 0xFF);
+        d[at + 3] = (byte) (v & 0xFF);
+    }
+
+    private static void writeU16(byte[] d, int at, int v) {
+        d[at] = (byte) ((v >>> 8) & 0xFF);
+        d[at + 1] = (byte) (v & 0xFF);
+    }
+}
