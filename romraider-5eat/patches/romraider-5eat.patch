     public static void main(String args[]) {
+        // Crisp text. Java on Windows otherwise falls back to grayscale
+        // antialiasing, which looks soft even at 100% display scaling -- which is
+        // the actual cause of the "fuzzy" appearance, not HiDPI scaling.
+        if (System.getProperty("awt.useSystemAAFontSettings") == null) {
+            System.setProperty("awt.useSystemAAFontSettings", "lcd");
+        }
+        if (System.getProperty("swing.aatext") == null) {
+            System.setProperty("swing.aatext", "true");
+        }
+
